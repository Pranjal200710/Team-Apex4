    async start() {
      injectCSS();
      this.record = await this.opts.fetchRecord();
      this.host.innerHTML = this.shell();
      this.cache();
      this.bind();
      this.renderAll();
      this.log('👁', 'History opened — protected columns withheld');
      if (this.record.masked === false) this.showGranted();
    }

    /* ---------------- shell markup ---------------- */
    shell() {
      const p = this.record.patient, v = p.vitals;
      return `
      <div class="hx">
        <header class="topbar"><div class="topbar-in">
          <div class="logo"><span class="logo-mark">✚</span> Meridian Health</div>
          <nav class="nav">
            <a href="#">Overview</a><a href="#" class="active">Medical history</a>
            <a href="#">Medications</a><a href="#">Reports</a><a href="#">Appointments</a>
          </nav>
          <div class="topbar-right">
            <span class="badge"><span class="dot"></span> Gateway active</span>
            <div class="avatar">${esc(initials(p.name))}</div>
          </div>
        </div></header>

        <div class="wrap">
          <div class="crumb">Home / Medical record / <strong style="color:#5f7280">Medical history</strong></div>

          <div class="card"><div class="patient">
            <div class="patient-av">${esc(initials(p.name))}</div>
            <div>
              <div class="patient-name">${esc(p.name)}</div>
              <div class="patient-meta">${p.age} y · ${esc(p.sex)} · MRN ${esc(p.mrn)} · Blood group ${esc(p.blood_group)} · Registered ${esc(p.registered)}</div>
            </div>
            <div class="patient-right">Primary physician<br>
              <strong style="color:#12232e">${esc(p.physician)}</strong> · ${esc(p.department)}</div>
          </div></div>

          <div class="card">
            <div class="card-head">
              <h2>Consultation history</h2>
              <span class="sub" data-hx="rowCount"></span>
              <span class="pill pill-lock" style="margin-left:auto" data-hx="tablePill">🔒 columns masked</span>
            </div>
            <div class="filters">
              <input class="search" data-hx="search" placeholder="Search by doctor, department or visit type…">
              <button class="chipbtn on" data-year="all">All</button>
              <button class="chipbtn" data-year="2026">2026</button>
              <button class="chipbtn" data-year="2025">2025</button>
            </div>
            <div class="table-scroll">
              <table>
                <thead><tr>
                  <th style="width:44px"></th><th style="width:110px">Date</th>
                  <th style="width:130px">Visit type</th><th>Diagnosis summary 🔒</th>
                  <th style="width:180px">Doctor assigned</th><th style="width:210px">Prescription 🔒</th>
                  <th style="width:110px">Status</th>
                </tr></thead>
                <tbody data-hx="tbody"></tbody>
              </table>
            </div>
            <div class="unlock locked" data-hx="bar">
              <div class="ic" data-hx="icon">🔒</div>
              <div class="tx">
                <div class="ti" data-hx="title">Diagnosis and prescription columns are masked</div>
                <div class="su" data-hx="sub">Dates, visit types and the doctor you saw are always visible. What you were diagnosed with and what was prescribed need your care team's approval.</div>
              </div>
              <button class="btn" data-hx="btn">Request access</button>
            </div>
          </div>

          <div class="card">
            <div class="card-head">
              <h2>Active prescriptions</h2>
              <span class="sub" data-hx="rxCount"></span>
              <span class="pill pill-lock" style="margin-left:auto" data-hx="rxPill">🔒 Masked</span>
            </div>
            <div class="table-scroll"><table>
              <thead><tr>
                <th style="width:220px">Medicine 🔒</th><th style="width:130px">Dose 🔒</th>
                <th style="width:140px">Frequency</th><th style="width:130px">Started</th>
                <th>Prescribed by</th><th style="width:120px">Status</th>
              </tr></thead>
              <tbody data-hx="rxBody"></tbody>
            </table></div>
          </div>

          <div class="lower">
            <div class="card">
              <div class="card-head"><h2>Investigations</h2><span class="sub">Lab results on file</span></div>
              <div class="table-scroll narrow"><table>
                <thead><tr>
                  <th style="width:130px">Date</th><th>Test</th>
                  <th style="width:150px">Result 🔒</th><th style="width:130px">Reference</th>
                  <th style="width:110px">Flag</th>
                </tr></thead>
                <tbody data-hx="labBody"></tbody>
              </table></div>
            </div>

            <div style="display:grid;gap:20px">
              <div class="card" style="margin:0">
                <div class="card-head"><h2>Latest vitals</h2></div>
                <div class="card-body" style="padding:8px 20px 16px">
                  <div class="vital"><span>Blood pressure</span><span><b>${esc(v.bp)}</b><span class="u">mmHg</span></span></div>
                  <div class="vital"><span>Pulse</span><span><b>${v.pulse}</b><span class="u">bpm</span></span></div>
                  <div class="vital"><span>Weight</span><span><b>${v.weight}</b><span class="u">kg</span></span></div>
                  <div class="vital"><span>BMI</span><span><b>${v.bmi}</b></span></div>
                  <div class="vital"><span>Recorded</span><span style="color:#8a9aa6;font-size:13px">${esc(v.recorded)}</span></div>
                </div>
              </div>
              <div class="card" style="margin:0">
                <div class="card-head"><h2>Access trail</h2></div>
                <div class="card-body" style="padding:8px 20px 16px">
                  <ul class="audit" data-hx="audit"></ul>
                </div>
              </div>
            </div>
          </div>
        </div>

        <button class="fab" data-hx="fab">💬</button>
        <div class="chat" data-hx="chat">
          <div class="chat-head"><span>🤖</span> Care Assistant<button class="x" data-hx="chatClose">×</button></div>
          <div class="log" data-hx="log">
            <div class="msg bot">Hi ${esc(p.name.split(' ')[0])}. I can walk you through your visit history, book appointments or explain a report. Anything clinical goes to your doctor for approval first.</div>
          </div>
          <div class="suggest">
            <button class="chip" data-ask="Show my diagnosis and prescriptions">Show my diagnosis</button>
            <button class="chip" data-ask="When is my next appointment?">Next appointment</button>
          </div>
          <div class="chat-in">
            <input data-hx="input" placeholder="Ask something…"><button data-hx="send">➤</button>
          </div>
        </div>

        ${this.opts.demoControls ? `
        <div class="demo" data-hx="demo">
          <b data-hx="demoToggle">Demo controls</b>
          <button data-hx="approve">✅ Doctor approves</button>
          <button data-hx="deny">⛔ Doctor denies</button>
          <button data-hx="reset">↺ Reset page</button>
        </div>` : ''}

        <div class="toast" data-hx="toast"></div>
      </div>`;
    }

    cache() {
      this.el = {};
      this.host.querySelectorAll('[data-hx]').forEach(n => { this.el[n.dataset.hx] = n; });
    }

    bind() {
      this.el.btn.onclick = () => this.request();
      this.el.fab.onclick = () => this.chat(true);
      this.el.chatClose.onclick = () => this.chat(false);
      this.el.send.onclick = () => this.ask();
      this.el.input.onkeydown = e => { if (e.key === 'Enter') this.ask(); };
      this.host.querySelectorAll('[data-ask]').forEach(b => b.onclick = () => this.ask(b.dataset.ask));

      this.el.search.oninput = e => { this.query = e.target.value.toLowerCase().trim(); this.renderVisits(); };
      this.host.querySelectorAll('[data-year]').forEach(b => {
        b.onclick = () => {
          this.host.querySelectorAll('[data-year]').forEach(x => x.classList.remove('on'));
          b.classList.add('on');
          this.year = b.dataset.year;
          this.renderVisits();
        };
      });

      if (this.opts.demoControls) {
        this.el.approve.onclick = () => this.approve();
        this.el.deny.onclick = () => this.deny();
        this.el.reset.onclick = () => this.start();
        this.el.demoToggle.onclick = () => this.el.demo.classList.toggle('min');
      }
    }

    /* ---------------- a masked-or-real cell ---------------- */
    cell(value, width) {
      return value == null
        ? `<span class="masked ${width || ''}"></span>`
        : `<span class="reveal">${esc(value)}</span>`;
    }

    /* ---------------- tables ---------------- */
    renderVisits() {
      const rows = this.record.visits.filter(v => {
        const yearOk = this.year === 'all' || v.iso.startsWith(this.year);
        const hay = (v.doctor + ' ' + v.dept + ' ' + v.type + ' ' + v.date).toLowerCase();
        return yearOk && hay.includes(this.query);
      });

      this.el.rowCount.textContent = rows.length + (rows.length === 1 ? ' visit' : ' visits');

      if (!rows.length) {
        this.el.tbody.innerHTML = `<tr><td colspan="7" class="empty-row">No visits match that filter.</td></tr>`;
        return;
      }

      this.el.tbody.innerHTML = rows.map(v => `
        <tr class="row ${this.openRows.has(v.id) ? 'open' : ''}" data-id="${v.id}">
          <td><span class="caret">▸</span></td>
          <td class="col-date">${esc(v.date.slice(0, 6))}<span class="yr">${esc(v.date.slice(7))}</span></td>
          <td><span class="pill pill-grey">${esc(v.type)}</span></td>
          <td class="locked-col">${this.cell(v.dx, 'w-lg')}</td>
          <td class="doc">${esc(v.doctor)}<span class="dept">${esc(v.dept)}</span></td>
          <td class="locked-col rx">${
            v.rx === '—' ? '<span style="color:#8a9aa6">None</span>'
                         : this.cell(v.rx) + (v.dose ? `<span class="dose">${esc(v.dose)}</span>` : '')}</td>
          <td><span class="pill pill-ok">${esc(v.status)}</span></td>
        </tr>
        <tr class="detail ${this.openRows.has(v.id) ? 'show' : ''}" data-d="${v.id}">
          <td colspan="7"><div class="detail-grid">
            <div><b>Visit ID</b>${esc(v.id)}</div>
            <div><b>ICD-10</b>${this.cell(v.icd, 'w-sm')}</div>
            <div><b>Recorded vitals</b>${esc(v.vitals)}</div>
            <div style="grid-column:1/-1"><b>Clinician's note</b>${
              v.note == null ? '<span class="masked" style="width:100%;height:34px"></span>' : esc(v.note)}</div>
          </div></td>
        </tr>`).join('');

      this.host.querySelectorAll('tr.row').forEach(tr => {
        tr.onclick = () => {
          const id = tr.dataset.id;
          this.openRows.has(id) ? this.openRows.delete(id) : this.openRows.add(id);
          tr.classList.toggle('open');
          this.host.querySelector(`tr.detail[data-d="${id}"]`).classList.toggle('show');
        };
      });
    }

    renderRx() {
      this.el.rxBody.innerHTML = this.record.prescriptions.map(r => `
        <tr>
          <td class="locked-col"><strong>${this.cell(r.med)}</strong></td>
          <td class="locked-col">${this.cell(r.dose, 'w-sm')}</td>
          <td>${esc(r.freq)}</td>
          <td>${esc(r.since)}</td>
          <td>${esc(r.by)}</td>
          <td><span class="pill ${r.status === 'Active' ? 'pill-ok' : 'pill-warn'}">${esc(r.status)}</span></td>
        </tr>`).join('');
      const active = this.record.prescriptions.filter(r => r.status === 'Active').length;
      this.el.rxCount.textContent = active + ' running';
    }

    renderLabs() {
      this.el.labBody.innerHTML = this.record.labs.map(l => `
        <tr>
          <td style="white-space:nowrap">${esc(l.date)}</td>
          <td>${esc(l.test)}</td>
          <td class="locked-col"><strong>${this.cell(l.result, 'w-sm')}</strong></td>
          <td style="color:#8a9aa6">${esc(l.ref)}</td>
          <td>${l.flag == null ? '<span class="masked w-sm"></span>'
              : `<span class="pill ${l.flag === 'High' ? 'pill-warn' : 'pill-ok'}">${esc(l.flag)}</span>`}</td>
        </tr>`).join('');
    }

    renderAll() { this.renderVisits(); this.renderRx(); this.renderLabs(); }

    /* ---------------- small UI ---------------- */
    toast(t) {
      this.el.toast.textContent = t;
      this.el.toast.classList.add('show');
      clearTimeout(this._tT);
      this._tT = setTimeout(() => this.el.toast.classList.remove('show'), 2600);
    }

    log(icon, html) {
      const li = document.createElement('li');
      li.innerHTML = `<span class="t">${clock()}</span><span>${icon}</span><span>${html}</span>`;
      this.el.audit.prepend(li);
    }

    setPills(cls, text) {
      [this.el.tablePill, this.el.rxPill].forEach(p => { p.className = 'pill ' + cls; p.textContent = text; });
    }

    /* ---------------- 1. request ---------------- */
    async request() {
      if (this.state !== 'locked') return;

      if (this.opts.requestAccess) {
        try { this.ticketId = (await this.opts.requestAccess()).ticket_id; }
        catch (e) { return this.toast(e.message); }
      } else {
        this.ticketId = 'REQ-' + Math.floor(1000 + Math.random() * 9000);
      }

      this.state = 'pending';
      this.el.bar.className = 'unlock pending';
      this.el.icon.textContent = '⏳';
      this.el.title.innerHTML = `Request sent to ${esc(this.record.patient.physician)} <span class="pill pill-warn" style="margin-left:6px">${esc(this.ticketId)}</span>`;
      this.el.sub.innerHTML = '<span class="spinner"></span> &nbsp;Waiting for approval. The masked columns fill in here the moment it is granted.';
      this.el.btn.textContent = 'Awaiting approval';
      this.el.btn.disabled = true;
      this.setPills('pill-warn', '⏳ Approval pending');

      this.log('🛡️', 'Intent classified <b>view_history</b> · risk <b>HIGH</b>');
      this.log('📨', `Ticket ${esc(this.ticketId)} raised`);
      this.bot(`I've raised request <b>${esc(this.ticketId)}</b>. The diagnosis and prescription columns unlock here as soon as it's approved.`);
    }

    /* ---------------- 2. approved ----------------
       Real build: call page.approve({record, doctor}) from the WebSocket
       handler, passing the record you refetched with the scoped token. */
    approve(payload) {
      if (this.state !== 'pending') return this.toast('Raise a request first');
      this.record = (payload && payload.record) || JSON.parse(JSON.stringify(DATA));
      this.renderAll();
      this.showGranted(payload && payload.doctor);
      this.log('✅', `${esc(this.ticketId)} approved (MFA verified)`);
      this.log('🔑', 'Scoped token issued · scope <b>history:read</b> · TTL 5 min');
      this.toast('Approved — masked columns unlocked');
      this.bot('Approved. Your full history is visible now and re-masks in 5 minutes.');
    }

    showGranted(doctor) {
      this.state = 'granted';
      this.left = this.opts.scopeSeconds;
      this.el.bar.className = 'unlock granted';
      this.el.icon.textContent = '🔓';
      this.el.title.textContent = doctor ? 'Access granted by ' + doctor : 'Access granted';
      this.el.btn.textContent = 'Lock now';
      this.el.btn.disabled = false;
      this.el.btn.onclick = () => this.expire();
      this.setPills('pill-ok', '🔓 Unlocked');
      clearInterval(this.timer);
      this.tick();
      this.timer = setInterval(() => this.tick(), 1000);
    }

    tick() {
      const m = Math.floor(this.left / 60), s = String(this.left % 60).padStart(2, '0');
      this.el.sub.innerHTML = `Permission expires in <span class="countdown">${m}:${s}</span> — the columns re-mask on their own.`;
      if (this.left-- <= 0) this.expire();
    }

    /* ---------------- 3. expire ---------------- */
    expire() {
      clearInterval(this.timer);
      this.record = redact(this.record);
      this.renderAll();
      this.state = 'locked'; this.ticketId = null;
      this.el.bar.className = 'unlock locked';
      this.el.icon.textContent = '🔒';
      this.el.title.textContent = 'Diagnosis and prescription columns are masked';
      this.el.sub.textContent = 'Your permission expired. Raise a new request whenever you need it.';
      this.el.btn.textContent = 'Request access';
      this.el.btn.disabled = false;
      this.el.btn.onclick = () => this.request();
      this.setPills('pill-lock', '🔒 columns masked');
      this.log('🔒', 'Permission expired · columns re-masked');
    }

    /* ---------------- denied ---------------- */
    deny(reason) {
      if (this.state !== 'pending') return this.toast('Raise a request first');
      const why = reason || 'Your doctor would like to go through these results with you at your next visit.';
      this.state = 'locked';
      this.el.bar.className = 'unlock denied';
      this.el.icon.textContent = '⛔';
      this.el.title.textContent = 'Request declined';
      this.el.sub.textContent = why;
      this.el.btn.textContent = 'Request again';
      this.el.btn.disabled = false;
      this.setPills('pill-lock', '🔒 columns masked');
      this.log('⛔', `${esc(this.ticketId)} declined`);
      this.bot(why + ' Shall I show you her open slots?');
      this.ticketId = null;
    }

    /* ---------------- chat ---------------- */
    chat(open) {
      this.el.chat.classList.toggle('open', open);
      this.el.fab.style.display = open ? 'none' : 'block';
    }

    push(cls, html) {
      const d = document.createElement('div');
      d.className = 'msg ' + cls;
      d.innerHTML = html;
      this.el.log.appendChild(d);
      this.el.log.scrollTop = this.el.log.scrollHeight;
    }

    bot(html) { setTimeout(() => this.push('bot', html), 450); }

    async ask(preset) {
      const text = preset || this.el.input.value.trim();
      if (!text) return;
      this.el.input.value = '';
      this.chat(true);
      this.push('me', esc(text));

      // Real build: sendChat posts to FastAPI, which runs the model server-side.
      if (this.opts.sendChat) {
        try {
          const r = await this.opts.sendChat(text);
          this.push('sys', `classified as ${esc(r.action)} · risk ${esc(r.risk)}`);
          this.bot(esc(r.reply));
          if (r.status === 'pending') { this.ticketId = r.ticket_id; this.request(); }
        } catch (e) { this.bot('Something went wrong: ' + esc(e.message)); }
        return;
      }

      // Mock classifier — keyword match until the backend is up.
      const sensitive = /diagnos|prescription|medicine|drug|lab|hba1c|result|report|history|condition/i.test(text);
      if (sensitive) {
        setTimeout(() => this.push('sys', '🛡️ classified HIGH risk — human approval required'), 350);
        setTimeout(() => {
          if (this.state === 'locked') this.request();
          else if (this.state === 'pending') this.bot('That request is still with your doctor.');
          else this.bot("It's already unlocked in the table above.");
        }, 850);
      } else {
        this.bot(`Your next review is <b>${esc(this.record.patient.next_appointment)}</b>. Want me to add it to your calendar?`);
      }
    }
  }

  /* ======================================================================
     5. PUBLIC API
     ====================================================================== */
  return {
    mount(selector, options) {
      const host = typeof selector === 'string' ? document.querySelector(selector) : selector;
      if (!host) throw new Error('HistoryPage: no element matches ' + selector);
      const page = new Page(host, options);
      page.start();
      return page;      // keep it — your WebSocket calls page.approve(...)
    },
    DATA,
    redact,
  };
})();
