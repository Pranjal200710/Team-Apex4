  };

  function redact(full) {
    const copy = JSON.parse(JSON.stringify(full));
    Object.keys(PROTECTED).forEach(coll => {
      copy[coll].forEach(item => PROTECTED[coll].forEach(k => { item[k] = null; }));
    });
    copy.masked = true;
    return copy;
